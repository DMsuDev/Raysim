# =============================================================================
# Git Attributes Configuration for Raysim
# Normalizes line endings, marks export-ignore files, and sets diff strategies
# =============================================================================

# ===================================================================
# Auto-detect text vs binary files (safer than trusting extensions)
# ===================================================================
* text=auto eol=lf

# ===================================================================
# SOURCE CODE - Always LF (Unix line endings)
# ===================================================================
*.cpp text eol=lf
*.cc  text eol=lf
*.c   text eol=lf
*.hpp text eol=lf
*.hh  text eol=lf
*.h   text eol=lf
*.inl text eol=lf
*.ipp text eol=lf

# ===================================================================
# BUILD FILES - Always LF
# ===================================================================
CMakeLists.txt text eol=lf
*.cmake        text eol=lf

# ===================================================================
# SCRIPTS & CONFIG - Always LF
# ===================================================================
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf

# SVG is XML/text — normalize like source code
*.svg text eol=lf

# Pre-commit & Git config
.pre-commit-config.yaml text eol=lf
.clang-format           text eol=lf
.clang-tidy             text eol=lf
.editorconfig           text eol=lf

# ===================================================================
# WINDOWS SCRIPTS - Always CRLF (Required by Windows tooling)
# ===================================================================
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ===================================================================
# VISUAL STUDIO / MSVC - Always CRLF (Windows project files)
# ===================================================================
*.vcxproj         text eol=crlf
*.vcxproj.filters text eol=crlf
*.sln             text eol=crlf

# ===================================================================
# BINARY FILES - Never normalize line endings
# ===================================================================
# Images
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.bmp  binary

# Archives
*.zip binary
*.7z  binary
*.rar binary
*.tar binary
*.gz  binary

# Compiled & object files
*.dll   binary
*.exe   binary
*.lib   binary
*.obj   binary
*.a     binary
*.so    binary
*.dylib binary
*.o     binary

# Debug symbols
*.pdb  binary
*.dSYM binary

# Fonts
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary

# ===================================================================
# EXPORT-IGNORE: Exclude from `git archive` / release tarballs
# Only development-only paths that consumers never need.
# ===================================================================

# CI/CD workflows
.github/ export-ignore

# Git configuration & hooks
.gitignore              export-ignore
.gitattributes          export-ignore
.pre-commit-config.yaml export-ignore
.gitleaksignore         export-ignore

# Development tools & scripts
tools/   export-ignore
scripts/ export-ignore

# Build & cache directories (regenerated on configure/build)
build/           export-ignore
_deps/           export-ignore
.cache/          export-ignore

# vcpkg (large; users bootstrap from vcpkg.json)
vcpkg/           export-ignore
vcpkg_installed/ export-ignore

# IDE & editor files
.vscode/ export-ignore
.idea/   export-ignore

# Visual Studio project files (generated by CMake)
*.sln             export-ignore
*.vcxproj         export-ignore
*.vcxproj.filters export-ignore

# CMake user/machine-specific presets
CMakeUserPresets.json export-ignore

# Test & example build outputs
examples/*/build/ export-ignore

# Documentation generation artifacts (source is sufficient)
docs/doxygen/ export-ignore
docs/html/    export-ignore

# OS metadata (should be in .gitignore, listed here as safety net)
.DS_Store  export-ignore
Thumbs.db  export-ignore

# ===================================================================
# DIFF STRATEGY
# Only built-in drivers are used (cpp, markdown ship with Git).
# cmake/json require manual .gitconfig setup — omitted to avoid
# silent no-ops on machines without those drivers configured.
# ===================================================================
*.md  diff=markdown
*.cpp diff=cpp
*.cc  diff=cpp
*.c   diff=cpp
*.hpp diff=cpp
*.hh  diff=cpp
*.h   diff=cpp

# ===================================================================
# MERGE STRATEGY: Prefer ours for generated / machine-specific files
# Prevents spurious conflicts when CMake or Git regenerates these.
# ===================================================================
CMakePresets.json  merge=ours
.gitattributes     merge=ours

# ===================================================================
# SHELL SCRIPTS - LF line endings, no built-in diff driver for sh
# Execute bit must be set via: git add --chmod=+x tools/*.sh
# ===================================================================
tools/*.sh   text eol=lf
scripts/*.sh text eol=lf
