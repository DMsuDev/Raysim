#pragma once

#include <cstdint>
#include <string_view>

/**
 * @file version.h
 * @brief Raysim semantic version information (compile-time and runtime).
 *
 * Raysim follows Semantic Versioning (MAJOR.MINOR.PATCH):
 *  - MAJOR: breaking API changes.
 *  - MINOR: backwards-compatible features.
 *  - PATCH: backwards-compatible bug fixes.
 *
 * Two equivalent APIs are provided:
 *  - Preprocessor macros (`RAYSIM_VERSION_*`), for use inside `#if` directives.
 *  - The `RS::version` namespace, preferred everywhere else in C++ code.
 */

// ============================================================================
// GENERATED FILE - DO NOT EDIT.
// ----------------------------------------------------------------------------
// This header is generated by CMake via configure_file() from version.h.in.
// The version is defined exclusively in:
//
//     project(Raysim VERSION <MAJOR.MINOR.PATCH>)
//
// inside the project's root CMakeLists.txt. To bump the version, edit only
// that line; do not edit this generated file directly.
// ============================================================================

// ============================================================================
// Preprocessor API
// ============================================================================

/// @def RAYSIM_VERSION_MAJOR
/// @brief Major version component (breaking changes).
#define RAYSIM_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/// @def RAYSIM_VERSION_MINOR
/// @brief Minor version component (backwards-compatible features).
#define RAYSIM_VERSION_MINOR @PROJECT_VERSION_MINOR@

/// @def RAYSIM_VERSION_PATCH
/// @brief Patch version component (backwards-compatible bug fixes).
#define RAYSIM_VERSION_PATCH @PROJECT_VERSION_PATCH@

/// @def RAYSIM_VERSION_STRING
/// @brief Human-readable version string, e.g. "1.2.3".
#define RAYSIM_VERSION_STRING "@PROJECT_VERSION@"

/// @def RAYSIM_VERSION_ENCODE(major, minor, patch)
/// @brief Packs a MAJOR.MINOR.PATCH triplet into a single comparable integer.
/// @details Encoding: major*10000 + minor*100 + patch (e.g. 1.2.3 -> 10203).
#define RAYSIM_VERSION_ENCODE(major, minor, patch) \
    (((major) * 10000u) + ((minor) * 100u) + (patch))

/// @def RAYSIM_VERSION
/// @brief The current Raysim version, packed via ::RAYSIM_VERSION_ENCODE.
#define RAYSIM_VERSION \
    RAYSIM_VERSION_ENCODE( \
        RAYSIM_VERSION_MAJOR, \
        RAYSIM_VERSION_MINOR, \
        RAYSIM_VERSION_PATCH)

/// @def RAYSIM_VERSION_AT_LEAST(major, minor, patch)
/// @brief Compile-time gate: true if the current version is >= the given one.
/// @par Example
/// @code
/// #if RAYSIM_VERSION_AT_LEAST(1, 2, 0)
///     // ...
/// #endif
/// @endcode
#define RAYSIM_VERSION_AT_LEAST(major, minor, patch) \
    (RAYSIM_VERSION >= RAYSIM_VERSION_ENCODE((major), (minor), (patch)))

// ============================================================================
// Modern C++ API
// ============================================================================

namespace RS::version {

/// @brief Major version component (breaking changes).
inline constexpr std::uint32_t major = RAYSIM_VERSION_MAJOR;

/// @brief Minor version component (backwards-compatible features).
inline constexpr std::uint32_t minor = RAYSIM_VERSION_MINOR;

/// @brief Patch version component (backwards-compatible bug fixes).
inline constexpr std::uint32_t patch = RAYSIM_VERSION_PATCH;

/// @brief Packed version number (e.g. 1.2.3 -> 10203).
inline constexpr std::uint32_t value = RAYSIM_VERSION;

/// @brief Human-readable version string (e.g. "1.2.3").
inline constexpr std::string_view string = RAYSIM_VERSION_STRING;

/**
 * @brief Encodes a semantic version triplet into Raysim's packed integer format.
 * @param major Major version component.
 * @param minor Minor version component.
 * @param patch Patch version component.
 * @return Packed integer: major*10000 + minor*100 + patch.
 *
 * @par Example
 * @code
 * encode(1, 2, 3) == 10203;
 * @endcode
 */
[[nodiscard]] constexpr std::uint32_t encode(
    std::uint32_t major_version,
    std::uint32_t minor_version,
    std::uint32_t patch_version) noexcept
{
    return RAYSIM_VERSION_ENCODE(major_version, minor_version, patch_version);
}

/**
 * @brief Checks whether the current Raysim version is >= the given version.
 * @param major Minimum required major version.
 * @param minor Minimum required minor version.
 * @param patch Minimum required patch version.
 * @return `true` if the current version is greater than or equal to the given version.
 *
 * @par Example
 * @code
 * if constexpr (RS::version::at_least(1, 1, 0)) {
 *     // ...
 * }
 * @endcode
 */
[[nodiscard]] constexpr bool at_least(
    std::uint32_t major_version,
    std::uint32_t minor_version,
    std::uint32_t patch_version) noexcept
{
    return value >= encode(major_version, minor_version, patch_version);
}

} // namespace RS::version
