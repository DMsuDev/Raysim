#include <windows.h>

// -----------------------------------------------------------------------------
//  Application Icon
// -----------------------------------------------------------------------------
IDI_ICON1 ICON "@RAYSIM_EXAMPLE_ICON_WIN@"

// -----------------------------------------------------------------------------
//  Version Information
// -----------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
  FILEVERSION    @Raysim_VERSION_MAJOR@, @Raysim_VERSION_MINOR@, @Raysim_VERSION_PATCH@, 0
  PRODUCTVERSION @Raysim_VERSION_MAJOR@, @Raysim_VERSION_MINOR@, @Raysim_VERSION_PATCH@, 0
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
  FILEFLAGS      0
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "@RAYSIM_AUTHOR@\0"
      VALUE "FileDescription",  "@RAYSIM_EXAMPLE_DESCRIPTION@\0"
      VALUE "FileVersion",      "@Raysim_VERSION_MAJOR@.@Raysim_VERSION_MINOR@.@Raysim_VERSION_PATCH@\0"
      VALUE "InternalName",     "@RAYSIM_EXAMPLE_TARGET@\0"
      VALUE "LegalCopyright",   "Copyright (c) @RAYSIM_COPYRIGHT_YEAR@ @RAYSIM_AUTHOR@\0"
      VALUE "OriginalFilename", "@RAYSIM_EXAMPLE_TARGET@.exe\0"
      VALUE "ProductName",      "Raysim\0"
      VALUE "ProductVersion",   "@Raysim_VERSION_MAJOR@.@Raysim_VERSION_MINOR@.@Raysim_VERSION_PATCH@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
